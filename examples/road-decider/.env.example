# Required for d1: get your key at https://console.liquid.ai
LIQUID_API_KEY=your-liquid-api-key
# Optional: override the d1 model name and API.
# To run d1 through OpenRouter, set LIQUID_BASE_URL=https://openrouter.ai,
# use your OpenRouter key as LIQUID_API_KEY, and set the OpenRouter model name.
# LIQUID_MODEL_NAME=d1:free
# LIQUID_BASE_URL=https://api.liquid.ai

# Optional: enables Jev vs d1 mode. Get your key at https://openrouter.ai
# OPENROUTER_API_KEY=your-openrouter-api-key
# Optional: override the Jev model name and API.
# OPENROUTER_MODEL_NAME=typesafe/jev-1.13
# OPENROUTER_BASE_URL=https://openrouter.ai
